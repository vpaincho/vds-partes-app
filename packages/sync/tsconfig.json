{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2023", "DOM"],
    // dexie's package.json `exports` map has no "types" condition, so under moduleResolution
    // NodeNext (the monorepo's setting) TS cannot find its declaration file through the normal
    // resolution path. This points directly at it rather than loosening resolution for every
    // package.
    "paths": { "dexie": ["../../node_modules/dexie/dist/dexie.d.ts"] }
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../domain/kernel"
    }
  ]
}
