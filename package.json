{
  "name": "vds-partes",
  "private": true,
  "version": "0.0.0",
  "description": "VDS Partes — Target Application (modular monolith: web + api + worker)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/domain/*"
  ],
  "scripts": {
    "verify": "npm run verify:sources && npm run gen:check && npm run arch:check && npm run typecheck && npm test && npm run test:db",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "verify:sources": "node scripts/verify-baseline.mjs --all",
    "gen": "npm run gen:state-machines && npm run gen:rules && npm run gen:tokens",
    "gen:state-machines": "node scripts/gen-state-machines.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:check": "node scripts/gen-state-machines.mjs --check && node scripts/gen-rules.mjs --check && node scripts/gen-tokens.mjs --check && python scripts/extract-canonical.py --check",
    "arch:check": "node scripts/arch-check.mjs",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "legacy": "node scripts/serve-legacy.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "gen:rules": "node scripts/gen-rules.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:reset": "node scripts/migrate.mjs --reset",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:reset": "node scripts/seed.mjs --truncate",
    "api:dev": "node --watch apps/api/src/server.ts",
    "web:dev": "npm run --prefix apps/web dev",
    "web:build": "npm run --prefix apps/web build"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "fake-indexeddb": "6.2.5",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
